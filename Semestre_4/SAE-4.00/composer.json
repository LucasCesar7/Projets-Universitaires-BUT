{
    "name": "sae4/social-media-awards",
    "description": "Social Media Awards – application PHP 8.3-8.5",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3 <8.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "guzzlehttp/guzzle": "^7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "config/paths.php",
            "config/upload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "assets:minify": "php tools/minify-assets.php",
        "test": "phpunit --testdox --no-progress"
    }
}
