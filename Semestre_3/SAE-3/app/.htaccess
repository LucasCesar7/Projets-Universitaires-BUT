# Bloquer l'indexation des dossiers
Options -Indexes -FollowSymLinks

# Bloquer les dotfiles (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
